#!/usr/bin/env sh
# ─────────────────────────────────────────────────────────────────────
# pre-push — the validation gate for this repo.
#
# `.github/workflows/ci.yml` runs the same steps on every pull request and
# on pushes to main/dev. This hook runs them locally too, so a checkpoint
# into main is validated before it leaves your machine.
#
# ── What runs, and when ──
#
# Pushing to main/master runs the FULL gate — exactly the steps ci.yml
# used to run. Pushing dev or a feature branch runs a fast guard, so the
# slow suite fires once per merge rather than once per commit.
#
# The intended flow (`dev` is the integration branch, and a checkpoint into
# `main` is a MERGE COMMIT, never a fast-forward or a squash):
#     git checkout -b <branch> origin/dev && ...work...
#     git push origin <branch>       # fast guard; open the PR into dev
#     # CI runs on the PR; the FULL gate also runs locally at the checkpoint
#     git checkout main && git merge --no-ff dev
#     git push origin main           # FULL gate runs here (the checkpoint)
#
# ⚠️ A `dev -> main` merge done with GitHub's Merge button advances the
# branch SERVER-SIDE and this hook never runs. The gate is only real for
# a LOCAL push. Checkpoint locally and push.
#
# Override, deliberately explicit: git push --no-verify
# ─────────────────────────────────────────────────────────────────────
set -e

FULL=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$remote_ref" ] && continue
  # A branch DELETION pushes an all-zero local sha — nothing to validate.
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  case "$remote_ref" in
    refs/heads/main|refs/heads/master) FULL=1 ;;
  esac
done

if [ "$FULL" -eq 0 ]; then
  echo "── pre-push: not targeting main/master — fast guard only"
  echo "   → pnpm lint"
  pnpm lint
  echo "   → pnpm check-types"
  pnpm check-types
  exit 0
fi

echo "── pre-push: target is main/master — running the FULL gate (replaces ci.yml)"
echo "   → pnpm lint"
pnpm lint
echo "   → pnpm check-types"
pnpm check-types
echo "   → pnpm test"
pnpm test
echo "   → pnpm build"
pnpm build

echo "── pre-push: full gate PASSED"
