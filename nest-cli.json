{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "tsc",
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      {
        "include": "modules/email/templates/**/*.ejs",
        "outDir": "build"
      }
    ],
    "watchAssets": true
  }
}
