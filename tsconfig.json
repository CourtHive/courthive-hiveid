{
  "compilerOptions": {
    "lib": ["ESNext.Array", "ES2017"],
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": false,
    "target": "ES6",
    "sourceMap": true,
    "outDir": "./build",
    "rootDir": "./src",
    // `src/...` imports resolve through this mapping. It replaced `baseUrl`, which TS7 refuses. The nest CLI
    // rewrites these specifiers to relative paths at build time from the same mapping.
    "paths": { "src/*": ["./src/*"] },
    "incremental": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "resolveJsonModule": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "strict": true,
    "tsBuildInfoFile": "./build/.tsbuildinfo",
    "types": ["node", "vitest/globals", "express", "supertest"]
  },
  "exclude": ["node_modules", "dist", "build", "migrations", "vitest.config.mts"]
}
