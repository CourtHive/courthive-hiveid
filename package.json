{
  "name": "courthive-hiveid",
  "packageManager": "pnpm@12.16.1",
  "private": true,
  "version": "0.4.3",
  "description": "HiveID auth/identity provider (IdP) for the CourtHive ecosystem. The dedicated ES256 token signer + auth authority lifted out of competition-factory-server; other services are relying parties. NestJS + Postgres (users in the shared courthive DB).",
  "author": "Charles Allen <charles@CourtHive.com> (CourtHive.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CourtHive/courthive-hiveid/issues",
    "email": "support@CourtHive.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CourtHive/courthive-hiveid.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rimraf build tsconfig.build.tsbuildinfo tsconfig.tsbuildinfo && nest build -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "NODE_ENV=production nest start",
    "start:prod": "NODE_ENV=production node build/main",
    "watch": "NODE_ENV=development nest start --watch",
    "lint": "eslint src --cache --max-warnings 0",
    "lint:fix": "eslint src --fix --cache",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "check-types": "node_modules/typescript7/bin/tsc --noEmit",
    "check-types:ts6": "node_modules/typescript/bin/tsc --noEmit",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "dependencies": {
    "@courthive/provider-config": "1.1.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.3.2",
    "bcryptjs": "3.0.3",
    "dotenv": "^18.0.0",
    "ejs": "7.0.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "reflect-metadata": "0.2.2",
    "resend": "^6.0.0",
    "rxjs": "7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.3.2",
    "@swc/core": "1.16.21",
    "@types/bcryptjs": "3.0.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "^8.20.0",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-sonarjs": "^4.1.0",
    "globals": "^17.7.0",
    "husky": "^9.0.11",
    "prettier": "3.9.10",
    "rimraf": "^6.1.3",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "ts-loader": "9.6.2",
    "typescript": "6.0.3",
    "typescript7": "npm:typescript@7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.0"
  }
}
