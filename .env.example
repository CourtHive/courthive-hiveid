# courthive-hiveid — environment (the HiveID identity provider)
# Copy to .env and fill in. Variables marked REQUIRED must be set for production.

# development | production | test
NODE_ENV=development

# HTTP port the IdP listens on.
PORT=3140

# --- Database (REQUIRED) ---
# The same PostgreSQL database competition-factory-server uses: the `users`,
# `user_providers` and `providers` tables live there, and CFS's migrations
# create them. The IdP owns writes to `users`; CFS keeps a read for roles.
PG_HOST=localhost
PG_PORT=5432
PG_USER=courthive
PG_PASSWORD=
PG_DATABASE=courthive

# --- Token signing (REQUIRED) ---
# The IdP is the only token signer. Generate a P-256 key pair, e.g.:
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt -out jwt-private.pem
#   openssl ec -in jwt-private.pem -pubout -out jwt-public.pem
# Put the PEM contents here (newlines as \n). Give relying parties (CFS) only
# JWT_PUBLIC_KEY and JWT_KID; they can also read the JWKS at
# /.well-known/jwks.json.
JWT_SIGN_ES256=true
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KID=
# During a key rotation, the previous public key keeps verifying older tokens.
# JWT_PUBLIC_KEY_PREVIOUS=
# JWT_KID_PREVIOUS=

# Legacy HS256 verification. Leave unset for an ES256-only deployment.
# JWT_SECRET=
# JWT_ACCEPT_HS256=false

# Shared secret CFS presents (as `x-service-token`) when it asks the IdP to sign
# tournament-scoped tokens at POST /internal/mint. REQUIRED in production: the
# IdP refuses to boot without it. Set the same value in CFS's .env. Never expose
# /internal/mint through a public reverse proxy.
HIVEID_SIGNER_TOKEN=

# --- Links in outbound email (optional) ---
# Public origin used to build password-reset, magic-link and verification links,
# plus the paths the TMX and public clients are served under.
APP_BASE_URL=
TMX_URL=/tmx/
PUBLIC_URL=/public/

# --- Email (optional) ---
# Without these, password login works; flows that send mail (password reset,
# magic links, contact-email verification) fail with a clear error.
RESEND_API_KEY=
EMAIL_FROM=

# --- courthive-persons (optional) ---
# Used only by HiveID self-signup to resolve the person record.
# PERSONS_BASE_URL=http://localhost:3100
# Shared secret presented to persons as `X-Service-Token`; must match
# PERSONS_SERVICE_TOKEN in the persons service .env.
# PERSONS_SERVICE_TOKEN=
